# Generic functions and if as an expression.
fn identity<T>(x: T) -> T {
  return x
}

fn last<T>(xs: [T]) -> T {
  return xs[-1]
}

fn map_pairs<K, V>(d: [K: V], f: fn(K, V) -> str) -> [str] {
  return d.keys().map(fn(k) => f(k, d[k]))
}

fn or_else<T>(x: T?, fallback: T) -> T {
  return x ?? fallback
}

struct Box<T> {
  value: T

  fn map<U>(f: fn(T) -> U) -> Box<U> {
    return Box(f(self.value))
  }
}

fn main() {
  let b = Box(21)
  assert(b.value == 21 and Box<str>("s").value == "s", "generic struct, inferred and spelled out")
  let doubled = b.map(fn(x) => x * 2)
  assert(doubled.value == 42, "generic method on a generic struct")
  let named = b.map(fn(x) => "n\(x)")
  assert(named.value == "n21" and str(named) == "Box<str>(value: \"n21\")", "method changes the type parameter")
  let opt: int? = 5
  assert((if let v = opt { v + 1 } else { 0 }) == 6, "if let as a value")
  assert(identity(5) == 5 and identity("s") == "s" and identity(true), "identity on three types")
  assert(last([1, 2, 3]) == 3 and last(["a", "b"]) == "b", "last")
  assert(last([[1], [2, 9]])[1] == 9, "nested lists")
  let rows = map_pairs(["a": 1, "b": 2], fn(k, v) => "\(k)=\(v)")
  assert(rows.join(",") == "a=1,b=2", "two type parameters, dict and closure")
  let missing: int? = nil
  let present: str? = "here"
  assert(or_else(missing, 7) == 7 and or_else(present, "no") == "here", "optionals bind T from the parameter")
  let n = 3
  let word = if n == 1 { "one" } else if n == 2 { "two" } else { "many" }
  assert(word == "many", "else if chain as a value")
  let o = if n > 2 { n } else { nil }
  assert(o == 3, "nil on one side makes an optional")
  let p = if n > 9 { n } else { nil }
  assert(p == nil, "the nil side")
  assert((if true { 1.5 } else { 2.5 }) == 1.5, "inline in an expression")
  let nested = if n > 1 { if n > 2 { "deep" } else { "mid" } } else { "shallow" }
  assert(nested == "deep", "nested if expressions")
  print("ok")
}
