# ai.pk: Plank scripts intelligence. A model, an ask, and a prompt you fill in.
#   import "lib/ai.pk" as ai
#   let m = ai.model("claude-haiku-5-5")        # Anthropic, key from ANTHROPIC_API_KEY
#   let m = ai.local("qwen", "http://localhost:8000/v1")   # any OpenAI-compatible server: oMLX, Ollama, Turing
#   let m = ai.turing()                         # Turing on this Mac, port 8127
#   let m = ai.mock()                           # no network; answers "echo: <prompt>", for tests
#   print(m.ask("Why is the sky blue?"))
struct Tool {
  name: str
  about: str
  params: [str: str]
  run: fn(Json) -> str

  # schema: what the model is told about this tool; params maps a name to str, int, float or bool.
  fn schema() -> Json {
    var props: [str: Json] = [:]
    var needed: [Json] = []
    for pair in self.params.items() {
      var kind = "string"
      if pair.1 == "int" {
        kind = "integer"
      } else if pair.1 == "float" {
        kind = "number"
      } else if pair.1 == "bool" {
        kind = "boolean"
      }
      props[pair.0] = Json.object(["type": Json.string(kind)])
      needed.append(Json.string(pair.0))
    }
    let shape = Json.object(["type": Json.string("object"), "properties": Json.object(props), "required": Json.array(needed)])
    return Json.object(["name": Json.string(self.name), "description": Json.string(self.about), "input_schema": shape])
  }

  # openai: the same tool in the shape OpenAI-compatible servers want.
  fn openai() -> Json {
    let fnc = Json.object(["name": Json.string(self.name), "description": Json.string(self.about), "parameters": self.schema().get("input_schema")])
    return Json.object(["type": Json.string("function"), "function": fnc])
  }
}

struct Model {
  name: str
  url: str = ""
  system: str = ""

  # empty means Anthropic

  # ask: one question in, one answer out. Throws with the server's words when it fails.
  fn ask(question: str) -> str {
    return text_of(self.step([user(question)], []))
  }

  # ask_json: ask for JSON and get a Json value back. Code fences are stripped; if the reply still does not parse, the model is shown the error and gets one more try.
  fn ask_json(question: str) -> Json {
    let first = self.ask(question + "\n\nReply with only JSON, no other text.")
    let got = attempt(fn() => json_parse(unfence(first)))
    if got.error() == nil {
      return got.value()
    }
    let again = self.ask(question + "\n\nYour last reply was not valid JSON (" + (got.error() ?? "") + "). Reply with only the JSON.")
    return json_parse(unfence(again))
  }

  # step: the whole conversation so far in, the model's next content blocks out (Anthropic message shape).
  fn step(history: [Json], tools: [Tool]) -> [Json] {
    if self.name == "mock" {
      return mock_step(history)
    }
    if self.url != "" {
      return self.step_openai(history, tools)
    }
    let key = env("ANTHROPIC_API_KEY") ?? ""
    if key == "" {
      throw "ANTHROPIC_API_KEY is not set"
    }
    var body: [str: Json] = ["model": Json.string(self.name), "max_tokens": Json.number(4096.0), "messages": Json.array(history)]
    if self.system != "" {
      body["system"] = Json.string(self.system)
    }
    if len(tools) > 0 {
      body["tools"] = Json.array(tools.map(fn(t) => t.schema()))
    }
    let headers = ["x-api-key: " + key, "anthropic-version: 2023-06-01", "content-type: application/json"]
    let reply = http("POST", "https://api.anthropic.com/v1/messages", Json.object(body).text(), headers)
    if status() != 200 {
      throw "ask failed (\(status())): " + reply
    }
    return json_parse(reply).get("content").items()
  }

  # step_openai: the same step against an OpenAI-compatible server (oMLX, Ollama, Turing), converting both ways.
  fn step_openai(history: [Json], tools: [Tool]) -> [Json] {
    var body: [str: Json] = ["model": Json.string(self.name), "messages": Json.array(to_openai(history, self.system))]
    if len(tools) > 0 {
      body["tools"] = Json.array(tools.map(fn(t) => t.openai()))
    }
    let reply = http("POST", self.url + "/chat/completions", Json.object(body).text(), ["content-type: application/json"])
    if status() != 200 {
      throw "ask failed (\(status())): " + reply
    }
    return from_openai(json_parse(reply).get("choices").at(0).get("message"))
  }
}

# An agent is a model, some tools, and an optional memory file. run(task) loops: ask, run the tools the
# model called, show it the results, until it answers in plain text.
struct Agent {
  model: Model
  tools: [Tool] = []
  memory: str = ""
  max_steps: int = 10
  keep: int = 0

  # 0 keeps everything; n keeps about the last n messages, cut at the start of a turn

  fn run(task: str) -> str {
    var history: [Json] = []
    if self.memory != "" {
      let saved = read_file(self.memory)
      if let text = saved {
        history = trim(json_parse(text).items(), self.keep)
      }
    }
    history.append(user(task))
    var answer = ""
    var done = false
    var steps = 0
    while not done {
      if steps == self.max_steps {
        throw "agent stopped after \(steps) steps without an answer"
      }
      steps += 1
      let blocks = self.model.step(history, self.tools)
      history.append(Json.object(["role": Json.string("assistant"), "content": Json.array(blocks)]))
      let calls = blocks.filter(fn(b) => b.get("type").str() == "tool_use")
      if len(calls) == 0 {
        answer = text_of(blocks)
        done = true
      } else {
        let results = calls.map(fn(c) => self.call(c))
        history.append(Json.object(["role": Json.string("user"), "content": Json.array(results)]))
      }
    }
    if self.memory != "" {
      write_file(self.memory, Json.array(trim(history, self.keep)).text())
    }
    return answer
  }

  # call: run one tool_use block; a throw or an unknown tool goes back to the model as an error result.
  fn call(c: Json) -> Json {
    let name = c.get("name").str()
    var out = "no tool called " + name
    var failed = true
    for t in self.tools {
      if t.name == name {
        let f = t.run
        let got = attempt(fn() => f(c.get("input")))
        failed = got.error() != nil
        out = got.error() ?? got.value()
      }
    }
    return Json.object(["type": Json.string("tool_result"), "tool_use_id": c.get("id"), "content": Json.string(out), "is_error": Json.bool(failed)])
  }
}

fn user(text: str) -> Json {
  return Json.object(["role": Json.string("user"), "content": Json.string(text)])
}

# text_of: the plain text in a list of content blocks.
fn text_of(blocks: [Json]) -> str {
  return blocks.filter(fn(b) => b.get("type").str() == "text").map(fn(b) => b.get("text").str()).join("")
}

# to_openai: Anthropic-shaped history as OpenAI chat messages; tool_use blocks become tool_calls, tool_result blocks become tool messages.
fn to_openai(history: [Json], system: str) -> [Json] {
  var out: [Json] = []
  if system != "" {
    out.append(Json.object(["role": Json.string("system"), "content": Json.string(system)]))
  }
  for m in history {
    let role = m.get("role").str()
    match m.get("content") {
      .string(text) {
        out.append(Json.object(["role": Json.string(role), "content": Json.string(text)]))
      }
      .array(blocks) {
        if role == "assistant" {
          var msg: [str: Json] = ["role": Json.string("assistant"), "content": Json.string(text_of(blocks))]
          let calls = blocks.filter(fn(b) => b.get("type").str() == "tool_use")
          if len(calls) > 0 {
            msg["tool_calls"] = Json.array(calls.map(fn(c) => Json.object(["id": c.get("id"), "type": Json.string("function"), "function": Json.object(["name": c.get("name"), "arguments": Json.string(c.get("input").text())])])))
          }
          out.append(Json.object(msg))
        } else {
          for b in blocks {
            out.append(Json.object(["role": Json.string("tool"), "tool_call_id": b.get("tool_use_id"), "content": b.get("content")]))
          }
        }
      }
      .null { }
      .bool(b) { }
      .number(n) { }
      .object(fields) { }
    }
  }
  return out
}

# from_openai: an OpenAI reply message as Anthropic-shaped content blocks.
fn from_openai(msg: Json) -> [Json] {
  var blocks: [Json] = []
  match msg.get("content") {
    .string(text) {
      if text != "" {
        blocks.append(Json.object(["type": Json.string("text"), "text": Json.string(text)]))
      }
    }
    .null { }
    .bool(b) { }
    .number(n) { }
    .array(items) { }
    .object(fields) { }
  }
  if "tool_calls" in msg.keys() {
    for c in msg.get("tool_calls").items() {
      let f = c.get("function")
      blocks.append(Json.object(["type": Json.string("tool_use"), "id": c.get("id"), "name": f.get("name"), "input": json_parse(f.get("arguments").str())]))
    }
  }
  return blocks
}

# mock_step: a model with no network. "use NAME {json}" calls that tool; "json X" answers X, for ask_json; a tool result comes back as "done: ..."; anything else echoes.
fn mock_step(history: [Json]) -> [Json] {
  let last = history[len(history) - 1].get("content")
  var reply = Json.object(["type": Json.string("text"), "text": Json.string("echo: ")])
  match last {
    .string(s) {
      if s.starts_with("use ") {
        let parts = s.split(" ")
        let args = s[5 + len(parts[1])..]
        reply = Json.object(["type": Json.string("tool_use"), "id": Json.string("mock_1"), "name": Json.string(parts[1]), "input": json_parse(args)])
      } else if s.starts_with("json ") {
        reply = Json.object(["type": Json.string("text"), "text": Json.string(s[5..].split("\n\n")[0])])
      } else {
        reply = Json.object(["type": Json.string("text"), "text": Json.string("echo: " + s)])
      }
    }
    .array(items) {
      reply = Json.object(["type": Json.string("text"), "text": Json.string("done: " + items.map(fn(r) => r.get("content").str()).join(" "))])
    }
    .null { }
    .bool(b) { }
    .number(n) { }
    .object(fields) { }
  }
  return [reply]
}

fn model(name: str, system: str = "") -> Model {
  return Model(name, "", system)
}

fn local(name: str, url: str, system: str = "") -> Model {
  return Model(name, url, system)
}

# turing: Joshua's own assistant, served on this Mac at port 8127 (turing/app/serve.py). It answers questions through its own pipeline and tools, and ignores a tool list on purpose, so use it for ask, not agents.
fn turing(system: str = "") -> Model {
  return Model("turing", "http://localhost:8127/v1", system)
}

fn mock() -> Model {
  return Model("mock")
}

# tool: a function the model may call. params maps each argument name to str, int, float or bool.
fn tool(name: str, about: str, params: [str: str], run: fn(Json) -> str) -> Tool {
  return Tool(name, about, params, run)
}

# agent: a model with tools. memory is a file that keeps the conversation between runs.
fn agent(m: Model, tools: [Tool], memory: str = "", keep: int = 0) -> Agent {
  return Agent(m, tools, memory, 10, keep)
}

# unfence: the text with a surrounding ``` or ```json fence removed, as models like to add one.
fn unfence(text: str) -> str {
  var t = text.trim()
  if t.starts_with("```") {
    let nl = t.find("\n") ?? 0
    t = t[nl + 1..]
    if t.ends_with("```") {
      t = t[..len(t) - 3]
    }
  }
  return t.trim()
}

# trim: drop the oldest messages, but only cut where a turn starts (a user message that is plain text),
# so a tool_result is never left without the tool_use that asked for it.
fn trim(history: [Json], keep: int) -> [Json] {
  if keep <= 0 or len(history) <= keep {
    return history
  }
  var start = len(history) - keep
  while start < len(history) and not turn_start(history[start]) {
    start += 1
  }
  if start == len(history) {
    start = len(history) - keep
    while start > 0 and not turn_start(history[start]) {
      start -= 1
    }
  }
  return history[start..]
}

fn turn_start(m: Json) -> bool {
  if m.get("role").str() != "user" {
    return false
  }
  match m.get("content") {
    .string(text) {
      return true
    }
    .null { }
    .bool(b) { }
    .number(n) { }
    .array(items) { }
    .object(fields) { }
  }
  return false
}

# prompt: fill {name} holes in a template from a dict, so a prompt is data you can keep and reuse.
fn prompt(template: str, vars: [str: str]) -> str {
  var out = template
  for pair in vars.items() {
    out = out.replace("{" + pair.0 + "}", pair.1)
  }
  return out
}
