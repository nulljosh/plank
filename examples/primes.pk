# while, var, break, and/or, bools.
fn is_prime(n: int) -> bool {
  if n < 2 { return false }
  var d = 2
  while d * d <= n {
    if n % d == 0 { return false }
    d = d + 1
  }
  return true
}

fn main() {
  var count = 0
  var n = 0
  while true {
    if is_prime(n) {
      print(n)
      count = count + 1
    }
    if count == 10 or n > 1000 { break }
    n = n + 1
  }
  print(count == 10 and is_prime(29))
}
