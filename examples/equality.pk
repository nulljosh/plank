# == that looks inside: lists, dicts, tuples, structs, enums and optionals, part by part.
struct P {
  x: int
  tags: [str] = []
}

enum S {
  a(n: int)
  b
}

fn main() {
  print([1, 2] == [1, 2], [1, 2] == [1, 3], [1] != [1, 1], [[1], [2]] == [[1], [2]])
  print(["a": 1] == ["a": 1], ["a": 1] == ["b": 1], ["a": 1, "b": 2] == ["b": 2, "a": 1])
  print((1, "x") == (1, "x"), (1, "x") != (2, "x"))
  print(P(1, ["t"]) == P(1, ["t"]), P(1) == P(2))
  print(S.a(3) == S.a(3), S.a(3) == S.a(4), S.b == S.b, S.a(1) != S.b)
  let o: int? = 3
  let n: int? = nil
  print(o == o, o == n, n == n, [o, n] == [o, n])
  let xs: [int] = []
  print(xs == [], [1] == [], ["k": 1] == [:])
  let pairs = [("a", [1]), ("b", [2])]
  print(pairs == [("a", [1]), ("b", [2])], pairs.index_of(("b", [2])))
}
