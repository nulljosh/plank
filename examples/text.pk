# Strings that work: join, compare, measure, interpolate, convert.
fn shout(word: str) -> str {
  return word + "!"
}

fn main() {
  let name = "plank"
  var greeting = "hello, " + name
  greeting += "."
  print(greeting)
  print("\(name) has \(len(name)) letters, 世界 has \(len("世界"))")
  print(shout("ship it"))

  print("apple" < "banana", "a" == "a", name != "swift")
  let n = int("42") + 1
  let f = float(" 2.5 ")
  print("int: \(n), float: \(f * 2.0), bool: \(n > 40)")
  print(str(7) + str(0.5) + str(true))

  var total = 10
  total -= 3
  total *= 6
  total %= 40
  print("total", total)
  print(min(3, 9), max(2.5, 1.0), abs(-4), sqrt(16.0), pow(2.0, 10.0), floor(2.7))
  print()
}
